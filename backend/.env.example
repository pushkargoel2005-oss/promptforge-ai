# Copy to .env and fill in real values. Never commit .env.
# .env already exists in this project — this file is documentation only.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=PromptForgeAI

# Backend port (frontend expects 5000 by default)
PORT=5000

# Local frontend origin(s) allowed by CORS, comma-separated
FRONTEND_URL=http://localhost:5173

# --- Authentication (required) ---
# Long random secret for signing auth/guest cookies. Generate one locally:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never share it or commit .env.
JWT_SECRET=paste-a-long-random-hex-string-here
# Set to true when serving the backend over https behind a real domain.
COOKIE_SECURE=false
# Daily generation allowances (UTC day). Change freely, no code changes needed.
GUEST_DAILY_LIMIT=3
USER_DAILY_LIMIT=20
# Max guest identities per device fingerprint per day (anti cookie-reset abuse).
GUEST_IDS_PER_FINGERPRINT=5

# --- Real AI provider (optional, backend only) ---
# Supported: AI_PROVIDER=openai  -> OpenAI via the official SDK (Responses API)
#            AI_PROVIDER=gemini  -> Google Gemini native v1beta REST API
# To enable real AI optimization:
#   1. Put your key in backend/.env (never in chat, frontend, or git).
#   2. Restart the backend and check Settings -> AI provider status.
# Never put these keys in frontend code, localStorage, or VITE_* variables.
AI_PROVIDER=none
AI_API_KEY=
# OPENAI_API_KEY=  (alternative name for OpenAI, also backend-only)
# GEMINI_API_KEY=  (alternative name for Gemini, also backend-only)
# GOOGLE_API_KEY=  (another accepted name for Gemini, also backend-only)
# Model to use when AI_PROVIDER is set (use a currently available model name).
# Examples: openai -> gpt-4o-mini ; gemini -> gemini-flash-latest (stable alias),
#   gemini-flash-lite-latest (lightest, best capacity during overload).
# (verify yours with: node gemini-model-probe.js  — your key is never printed)
AI_MODEL=gpt-4o-mini
# Optional: fallback Gemini model, tried once when the primary model answers
# 429/500/502/503 (rate limit / high demand). Config errors never trigger it.
# If unset, the backend still retries the primary once and then tries the
# stable flash aliases automatically. Recommended on deployed/Vercel setups:
# AI_FALLBACK_MODEL=gemini-flash-lite-latest
# Optional: point at an OpenAI-compatible gateway instead of OpenAI
AI_BASE_URL=https://api.openai.com
# Optional: provider request timeout in ms (max 120000)
AI_TIMEOUT_MS=45000
